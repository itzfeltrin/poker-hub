{
  "name": "poker-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "turbo run db:generate --filter=backend",
    "db:migrate": "turbo run db:migrate --filter=backend",
    "db:studio": "turbo run db:studio --filter=backend",
    "typecheck": "turbo run typecheck --filter=backend --filter=frontend --filter=@poker-hub/db"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.8.3",
    "vite-plugin-pwa": "^1.2.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "packageManager": "bun@1.2.0",
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "remeda": "^2.33.6",
    "workbox-window": "^7.4.0",
    "zod": "^4.3.6"
  }
}
