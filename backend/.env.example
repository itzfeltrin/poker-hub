# Shared password that gates the app (required).
# Copy to `.env` in this folder (Bun loads it when the API starts).
APP_PASSWORD=change-me

# Groq API key for voice game registration (Whisper + LLM). Optional.
GROQ_API_KEY=
# Optional chat model override (default: openai/gpt-oss-120b).
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
