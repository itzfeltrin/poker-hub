# Shared password that gates the app (required).
# Copy to `backend/.env` for local/dev, or set it in systemd/docker.
# You and your friends use the same password.
APP_PASSWORD=change-me

# Groq API key for voice game registration (Whisper + LLM). Optional.
# Without it, "Falar a partida" is hidden. Set this on the VM systemd unit too.
GROQ_API_KEY=
